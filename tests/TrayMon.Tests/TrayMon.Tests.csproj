<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything meaningful in TrayMon is hardware, drivers and the Windows shell, and none of
       that is testable here — that part of the README stands. What *is* testable is the half of
       the code that never touches a driver: the hand-rolled BER parser (which has already had a
       hang from a crafted packet), the GUID pool, the summary scale, the formatters and the
       settings round-trip against a hostile file. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrayMon.Tests</AssemblyName>
    <RootNamespace>TrayMon.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TrayMon.csproj" />
  </ItemGroup>

</Project>
