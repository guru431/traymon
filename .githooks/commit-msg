#!/bin/sh
# commit-msg secret-guard for a PUBLIC repository.
#
# The pre-commit hook only ever scanned `git diff --cached`, so the whole class
# "secret or internal host typed into `git commit -m`" was gated by nothing:
# not locally, and not in CI either — gitleaks looks at patch content, and even
# if it read messages it has no access to `.sanitize-patterns`, which is
# untracked/gitignored by design and is the ONLY gate for internal hosts,
# private IPs and personal names. On a public repo the value is disclosed at
# push time, and `--amend` does not retract it from mirrors or forks.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass a confirmed false positive:   git commit --no-verify
#
# Covered by tools/Test-GitHooks.sh, which drives a real `git commit -m` in a
# temporary repository — the only way to catch the `$2` mistake this hook made.
set -eu

hook_dir=$(dirname "$0")
# shellcheck source=.githooks/_scan.sh
. "$hook_dir/_scan.sh"

msg_file=$1

# The WHOLE file, comments included.
#
# This used to branch on `$2`, the message source — but git passes a second
# argument to `prepare-commit-msg`, NOT to `commit-msg`, which gets the file
# name and nothing else (git-scm.com/docs/githooks#_commit_msg). `$2` was
# therefore always empty, so the comment-stripping branch always ran, and
# `git commit -m` keeps `#` lines verbatim (its default cleanup is
# `whitespace`). A denylisted host typed after a `#` in a `-m` message passed
# every local check and reached the public remote.
#
# There is no locale-independent way to tell an editor-composed message from a
# `-m` one here, so this scans everything and accepts the one false positive it
# can produce: a blocked string inside git's own status template, which lists
# staged paths. That costs `--no-verify` once; the other direction costs a
# disclosure that `--amend` cannot retract from mirrors or forks.
msg=$(cat "$msg_file")

if ! scan_text "the commit message" "$msg"; then
  echo ""
  echo "Commit aborted — this is a PUBLIC repository."
  echo "Rewrite the message above, or for a confirmed false positive: git commit --no-verify"
  exit 1
fi
exit 0
