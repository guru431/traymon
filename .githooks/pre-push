#!/bin/sh
# pre-push secret-guard for a PUBLIC repository.
#
# pre-commit and commit-msg only see what they were present for: anything
# committed BEFORE the guard was enabled — which is the whole history of this
# repo, the guard was added late — or with `--no-verify`, still reaches the
# remote on push. This hook scans the objects a push would actually publish:
# the ones the TARGET remote does not have yet, plus their commit messages.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass a confirmed false positive:   git push --no-verify
set -eu

hook_dir=$(dirname "$0")
lib="$hook_dir/_scan.sh"
if [ ! -f "$lib" ]; then
  # Fail CLOSED. Exiting 0 here would turn "the guard is missing" into "the
  # guard passed" — on a public remote that is the one direction you cannot be
  # wrong in. Deleting the library must not become a way to publish unscanned
  # objects.
  echo "BLOCKED: $lib not found — the secret scan cannot run." >&2
  echo "Restore it, or push with --no-verify if you have checked by hand." >&2
  exit 1
fi
# shellcheck source=.githooks/_scan.sh
. "$lib"

repo_root=$(git rev-parse --show-toplevel)
fail=0

# Blobs above this are not hand-written text (the bundled .ico, build leftovers);
# a pasted key lives in a small file. Keeps a first push of the repo bounded.
max_blob_bytes=1048576

# 1) Refs being pushed. stdin: <local ref> <local sha> <remote ref> <remote sha>
# The TARGET remote is $1 (a name, or a URL for an ad-hoc push).
target_remote="${1:-}"
shas=""
excludes=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # An all-zeros local sha is a branch DELETION — it publishes no objects.
  case "$local_sha" in
    *[!0]*) shas="$shas $local_sha" ;;
    *) continue ;;
  esac
  case "$remote_sha" in
    *[!0]*) excludes="$excludes $remote_sha" ;;
  esac
done
[ -n "$shas" ] || exit 0

# Exclude only what the TARGET remote has. Excluding objects present on ANY
# remote would treat a commit already pushed to the private origin as published
# when it reaches the PUBLIC github for the first time — exactly the case this
# repo is in. An unnamed remote (a bare URL) matches no ref pattern, which just
# means everything gets scanned.
case "$target_remote" in
  ''|*[!A-Za-z0-9._/-]*) ;;
  *) excludes="$excludes --remotes=$target_remote" ;;
esac

tmpdir=$(mktemp -d 2>/dev/null || echo "$repo_root/.pre-push.tmp")
mkdir -p "$tmpdir"
trap 'rm -rf "$tmpdir"' EXIT INT TERM
all="$tmpdir/all"
objects="$tmpdir/objects"
types="$tmpdir/types"
blobs="$tmpdir/blobs"
tags="$tmpdir/tags"

# Every step below checks its own exit code and REFUSES on failure. They used to
# end in `|| true` inside a pipeline, so "git could not enumerate these objects"
# — an unknown sha, a corrupt pack, a missing object after a rewrite — produced
# an empty list and a clean verdict. On a public remote that is the one direction
# you cannot be wrong in.
die() {
  echo "BLOCKED: $1" >&2
  echo "The secret scan could not run, so nothing is pushed. Fix it, or push with --no-verify" >&2
  echo "if you have checked the outgoing objects by hand." >&2
  exit 1
}

# 2) New objects only. shellcheck disable=SC2086 — both must word-split.
rc=0
if [ -n "$excludes" ]; then
  # shellcheck disable=SC2086
  git rev-list --objects $shas --not $excludes > "$all" 2>"$tmpdir/err" || rc=$?
else
  # shellcheck disable=SC2086
  git rev-list --objects $shas > "$all" 2>"$tmpdir/err" || rc=$?
fi
[ "$rc" -eq 0 ] || die "git rev-list failed (rc=$rc): $(tr '\n' ' ' < "$tmpdir/err")"

# `awk NF>1` keeps the ones carrying a path (blobs, trees); commits and tags
# print bare. The path is needed for the message in step 5, the bare ones are
# still typed and scanned below.
awk 'NF>1' "$all" > "$objects"

# One batch-check pass instead of a process spawn per object.
rc=0
awk '{print $1}' "$all" \
  | git cat-file --batch-check='%(objectname) %(objecttype) %(objectsize)' > "$types" 2>"$tmpdir/err" || rc=$?
[ "$rc" -eq 0 ] || die "git cat-file --batch-check failed (rc=$rc): $(tr '\n' ' ' < "$tmpdir/err")"

awk -v max="$max_blob_bytes" '$2 == "blob" && $3 <= max {print $1}' "$types" > "$blobs"
awk '$2 == "tag" {print $1}' "$types" > "$tags"
# The pushed refs themselves: an annotated tag object is what `git push v1.0`
# publishes, and its message is written by hand exactly like a commit message.
for sha in $shas; do
  t=$(git cat-file -t "$sha" 2>/dev/null || true)
  [ "$t" = "tag" ] && echo "$sha" >> "$tags"
done

# SAY what was skipped: "scanned everything under 1 MiB" is a different promise
# from "scanned everything", and only the second one is worth staying silent about.
oversize=$(awk -v max="$max_blob_bytes" '$2 == "blob" && $3 > max' "$types" | wc -l | tr -d ' ')
if [ "${oversize:-0}" -gt 0 ]; then
  echo "pre-push: NOTE — $oversize blob(s) over $max_blob_bytes bytes were NOT scanned"
fi

# 3) COMMIT MESSAGES. commit-msg catches new ones, but this hook also publishes
# commits written before the guard existed. A token in a message is disclosed
# exactly as typed and `git log` keeps it forever.
rc=0
if [ -n "$excludes" ]; then
  # shellcheck disable=SC2086
  msgs=$(git log --format='%H%n%B%n' $shas --not $excludes 2>"$tmpdir/err") || rc=$?
else
  # shellcheck disable=SC2086
  msgs=$(git log --format='%H%n%B%n' $shas 2>"$tmpdir/err") || rc=$?
fi
[ "$rc" -eq 0 ] || die "git log failed (rc=$rc): $(tr '\n' ' ' < "$tmpdir/err")"
if [ -n "$msgs" ]; then
  if ! scan_text "an outgoing COMMIT MESSAGE" "$msgs"; then
    fail=1
  fi
fi

# 3b) TAG MESSAGES. Nothing looked at these at all: `-m` on `git tag -a` goes
# through no hook whatsoever, and the text is published with the tag.
if [ -s "$tags" ]; then
  while read -r sha; do
    [ -n "$sha" ] || continue
    body=$(git cat-file tag "$sha" 2>/dev/null || true)
    [ -n "$body" ] || die "could not read tag object $sha"
    if ! scan_text "an outgoing TAG MESSAGE ($sha)" "$body"; then
      fail=1
    fi
  done < "$tags"
fi

# 4) Fast path: one `cat-file --batch` stream through one grep, instead of two
# spawns per blob (~160ms each on Windows — minutes on a first push). It is
# deliberately over-eager: a hit here only means "look properly in step 5", so a
# false alarm costs seconds and never a wrong verdict.
#
# `tr -d '\000'` is what makes UTF-16 visible: a UTF-16 blob reads as
# `s\0k\0-\0…` and matches nothing, so without this the precise pass would never
# run. UTF-16 is what `>` and `Out-File` produce in Windows PowerShell 5.1 —
# the shell this project is built and released from.
pat="$tmpdir/patterns"
: > "$pat"
# The shared resolver, not this worktree's root: in a linked `git worktree` the
# untracked denylist lives with the MAIN checkout, so looking here found nothing
# and the fast path never suspected anything — while scan_text, which resolves it
# properly, was only reached if the generic pattern had already matched. A blob
# carrying only a personal marker went out unexamined.
sp=$(scan_denylist_path)
if [ -f "$sp" ]; then
  # tr -d '\r': a CRLF-saved denylist would leave a trailing \r on every line
  # and silently match nothing.
  grep -vE '^[[:space:]]*$' "$sp" 2>/dev/null | tr -d '\r' > "$pat" || true
fi

suspect=0
if [ -s "$blobs" ] && git cat-file --batch < "$blobs" 2>/dev/null | tr -d '\000' \
     | grep -qaE -e "$(scan_generic_pattern)"; then
  suspect=1
fi
if [ "$suspect" -eq 0 ] && [ -s "$blobs" ] && [ -s "$pat" ]; then
  if git cat-file --batch < "$blobs" 2>/dev/null | tr -d '\000' | grep -qaiEf "$pat"; then
    suspect=1
  fi
fi

if [ "$suspect" -ne 0 ]; then
  # 5) Something matched — now spend the per-blob spawns to name it.
  # Redirect, not a pipe: a pipe runs the loop in a subshell and every `fail=1`
  # set inside it is lost when that subshell exits.
  while read -r sha; do
    [ -n "$sha" ] || continue
    path=$(grep -m1 "^$sha " "$objects" | cut -d' ' -f2- || true)
    # Only _scan.sh, whose regex constants self-match the formats it defines —
    # the same narrow exclusion pre-commit makes. Excluding all of .githooks/
    # meant a concrete token pasted into a hook was published without a word.
    case "$path" in .githooks/_scan.sh) continue ;; esac
    body=$(git cat-file blob "$sha" 2>/dev/null | tr -d '\000' || true)
    if ! scan_text "$path (blob $sha)" "$body"; then
      fail=1
    fi
  done < "$blobs"
fi

rm -rf "$tmpdir"
trap - EXIT INT TERM

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Push aborted — this is a PUBLIC repository."
  echo "Objects already committed cannot be fixed by a new commit: rewrite the"
  echo "history that carries them (git rebase -i / git filter-repo). Rotate"
  echo "anything real that leaked."
  echo "For a confirmed false positive: git push --no-verify"
  exit 1
fi
exit 0
