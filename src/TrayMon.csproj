<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrayMon</AssemblyName>
    <RootNamespace>TrayMon</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Only for CPU package and NVMe temperatures: MSR and SMART reads go through the kernel
       driver this library ships. Everything else in TrayMon is plain P/Invoke.
       The NuGet build is required — the DLL shipped with FanControl targets netstandard2.0 and
       calls Mutex(bool, string, out bool, MutexSecurity), which .NET 8 does not have. -->
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

</Project>
